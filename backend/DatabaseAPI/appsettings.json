{
  "ConnectionStrings": {
    "DefaultConnection": "Server=mysql;Port=3306;Database=cepem_healthcare;User=cepem_user;Password=cepem_password;"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.Hosting": "Warning",
      "Microsoft.AspNetCore.Routing": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },

  "PhotoStorage": {
    "Path": "/app/patient-photos"
  },

  "DocumentStorage": {
    "Path": "/app/patient-documents"
  },

  "ActivityLogRetention": {
    "Enabled": true,
    "RetentionDays": 365,
    "RoutineRetentionDays": 30,
    "ImportantRetentionDays": 365,
    "MaxRows": 500000,
    "EmailLogRetentionDays": 365,
    "MaxEmailLogRows": 200000,
    "BatchSize": 5000,
    "CleanupIntervalHours": 6
  },

  "App": {
    "FrontendBaseUrl": "http://localhost:3000"
  },

  "IntakeReminder": {
    "Enabled": true,
    "LeadDays": 3,
    "CheckIntervalMinutes": 15
  },

  "Ocr": {
    "Enabled": true,
    "TesseractPath": "tesseract",
    "PdfToTextPath": "pdftotext",
    "PdfToPpmPath": "pdftoppm",
    "Languages": "ces+eng",
    "MaxPages": 5,
    "TimeoutSeconds": 60,
    "MaxTextLength": 200000
  },

  "Sms": {
    "Enabled": true,
    "Provider": "log",
    "Endpoint": "",
    "ApiKey": "",
    "Sender": "CEPEM",
    "TimeoutSeconds": 20
  },

  "SmsReminder": {
    "Enabled": true,
    "LeadHours": 24,
    "CheckIntervalMinutes": 30
  },

  "AllowedHosts": "*"
}
