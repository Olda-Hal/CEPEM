FROM node:22-alpine AS test

WORKDIR /app

# Copy package files
COPY package*.json ./
RUN npm ci --legacy-peer-deps --no-audit --no-fund

# Copy source code
COPY . .

# Fail the build on any failing test — no swallowing of the exit code.
RUN npm run test:coverage -- --reporter=default --reporter=junit --outputFile=junit.xml

FROM alpine:3.24
WORKDIR /results
COPY --from=test /app/coverage ./coverage
COPY --from=test /app/junit.xml ./junit.xml
CMD ["sh", "-c", "mkdir -p /results/frontend && cp -r /results/coverage /results/frontend/ && cp /results/junit.xml /results/frontend/junit.xml"]
