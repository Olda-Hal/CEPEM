# CEPEM Environment Variables Template
# Copy this file to .env and update the values as needed

# Version Information
CEPEM_VERSION=0.1.2
CEPEM_BUILD_NUMBER=2
CEPEM_BUILD_DATE=2025-09-30T15:45:58Z

# ============================================================================
# APPLICATION HOST CONFIGURATION
# Change APP_HOST here and everything else configures automatically
# Examples: localhost, example.com, api.myapp.com, etc.
# ============================================================================
APP_HOST=localhost

# Production domain (used by docker-compose.prod.yml for CORS + links).
# Example: DOMAIN_NAME=cepem.example.com
DOMAIN_NAME=example.com

# Public URL of the SPA — used in password-reset e-mails. MUST be the real
# HTTPS URL in production (not localhost), otherwise reset links are unusable.
FRONTEND_PUBLIC_URL=https://${DOMAIN_NAME}

# ============================================================================
# MySQL Database Configuration
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=cepem_healthcare
MYSQL_USER=cepem_user
MYSQL_PASSWORD=cepem_password
MYSQL_PORT=3306

# ASP.NET Core Configuration
# NOTE: must be set to "Production" when deploying (see docker-compose.prod.yml).
# Development enables detailed error pages and disables caching/optimization.
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS_HEALTHCARE=http://+:80
ASPNETCORE_URLS_DATABASE=http://+:5001

# Seeded admin account (created when no SysAdmin exists).
# If unset, admin creation is skipped with a warning in the database-api log.
ADMIN_INITIAL_PASSWORD=<set-a-strong-initial-password>
# Production: the initial admin must change the password on first login.
# CI/E2E can set false to keep the seeded session usable.
ADMIN_PASSWORD_CHANGE_REQUIRED=true

# Connection Strings
HEALTHCARE_API_CONNECTION_STRING=Server=mysql;Database=cepem_healthcare;Uid=cepem_user;Pwd=cepem_password;
# The API runs migrations, so it needs DDL rights on its own database; the
# MySQL image grants MYSQL_USER full rights on MYSQL_DATABASE. Never use root.
DATABASE_API_CONNECTION_STRING=Server=mysql;Database=cepem_healthcare;User=cepem_user;Password=cepem_password;

# JWT Configuration
# IMPORTANT: Change these values in production!
JWT_SECRET_KEY=CEPEMHealthcareSecretKey2024ForJWTTokens!
JWT_ISSUER=CEPEM-Healthcare
JWT_AUDIENCE=CEPEM-Doctors
# Short-lived access tokens, renewed with a long-lived refresh token.
JWT_ACCESS_TOKEN_MINUTES=30
JWT_REFRESH_TOKEN_DAYS=7

# Ports (Internal container ports)
HEALTHCARE_API_PORT=5000
DATABASE_API_PORT=5001
FRONTEND_PORT=3000

# API URLs (Derived from APP_HOST above)
# Change APP_HOST instead of editing these
DATABASE_API_URL=http://database-api:5001
# Leave empty for same-origin (recommended): the built frontend is served
# behind a proxy that forwards /api to HealthcareAPI
VITE_API_URL=

# Service-to-service authentication (shared between HealthcareAPI and DatabaseAPI)
# Generate with: openssl rand -hex 32
SERVICE_AUTH_KEY=<generate-a-64-hex-char-service-key>

# Encryption Configuration
# IMPORTANT: Change these values in production!
# Generate with: openssl rand -hex 32
PHOTO_ENCRYPTION_KEY=<generate-a-unique-64-hex-char-key>
PHOTO_ENCRYPTION_IV=<legacy-iv-for-old-files-only>
DOCUMENT_ENCRYPTION_KEY=<generate-a-unique-64-hex-char-key>
DOCUMENT_ENCRYPTION_IV=<legacy-iv-for-old-files-only>

# Storage Paths
PHOTO_STORAGE_PATH=/app/patient-photos
DOCUMENT_STORAGE_PATH=/app/patient-documents

# Soft-deleted patient/examination documents are purged after this window.
DOCUMENT_RETENTION_ENABLED=true
DOCUMENT_RETENTION_RETENTION_DAYS=30
DOCUMENT_RETENTION_CLEANUP_INTERVAL_HOURS=24

# Paper intake-form digitisation (AI service). Local OCR uses Tesseract
# (Czech + English). Set the optional OpenAI-compatible vision endpoint to
# improve handwritten-field extraction; empty = OCR/CV only.
TESSERACT_LANG=ces+eng
VISION_API_URL=
VISION_API_KEY=
VISION_MODEL=

# Antivirus scanning of uploaded photos/PDFs/measurements via clamd.
# The clamav container starts with the stack; scanning is skipped when false.
CLAMAV_ENABLED=true
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SECONDS=20
# false rejects uploads while clamd is unreachable (safe default).
CLAMAV_FAIL_OPEN=false

# CORS Configuration (Auto-generated from APP_HOST)
# These are automatically constructed - change APP_HOST to update all CORS origins
CORS_ORIGINS=http://${APP_HOST}:3000,http://frontend:3000
HEALTHCARE_API_CORS_ORIGINS=http://${APP_HOST}:3000,http://frontend:3000
DATABASE_CORS_ORIGINS=http://${APP_HOST}:3000,http://frontend:3000

# Production Notes:
# - MySQL container will be available in production via docker-compose
# - Local volumes are used for patient photos and documents
# - Connection strings use container name 'mysql' for internal communication

# ============================================================================
# SMTP / password-reset e-mail (database-api)
# Leave SMTP_HOST empty to keep the reset link in the container log.
# Use port 587 + STARTTLS (System.Net.Mail does not support implicit SSL/465).
# ============================================================================
SMTP_HOST=
SMTP_PORT=587
SMTP_ENABLE_SSL=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com
SMTP_FROM_NAME=CEPEM

# Pre-visit intake form reminder (database-api). The link is e-mailed
# INTAKE_REMINDER_LEAD_DAYS before a confirmed reservation.
INTAKE_REMINDER_ENABLED=true
INTAKE_REMINDER_LEAD_DAYS=3
INTAKE_REMINDER_CHECK_INTERVAL_MINUTES=15

# Day-before appointment SMS. "log" (default) records messages in
# Admin → Komunikační šablony → SMS log without calling an external service.
# For a real gateway set SMS_PROVIDER=http and SMS_ENDPOINT.
SMS_ENABLED=true
SMS_PROVIDER=log
SMS_ENDPOINT=
SMS_API_KEY=
SMS_SENDER=CEPEM
SMS_REMINDER_ENABLED=true
SMS_REMINDER_LEAD_HOURS=24
SMS_REMINDER_CHECK_INTERVAL_MINUTES=30

# Observability: Grafana + Prometheus (docker-compose.prod.yml).
# REQUIRED on production: set a strong Grafana admin password. Generous
# secret via `openssl rand -hex 16`.
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=<set-a-strong-grafana-admin-password>
GRAFANA_PORT=3001
# Grafana is published under https://${DOMAIN_NAME}/grafana/ by nginx.
# Only override GRAFANA_ROOT_URL for an SSH tunnel, e.g.
# GRAFANA_ROOT_URL=http://localhost:3001
# GRAFANA_ROOT_URL=
GRAFANA_SERVE_FROM_SUB_PATH=true
GRAFANA_COOKIE_SECURE=true
# Build-time URL baked into the frontend. Leave empty to use the same-origin
# /grafana proxy; set an absolute URL only if Grafana lives on another host.
VITE_GRAFANA_URL=https://${DOMAIN_NAME}/grafana
# Optional Sentry error tracking (empty = disabled).
VITE_SENTRY_DSN=
# Backend error tracking (Serilog → Sentry); empty = disabled.
SENTRY_DSN=
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION=15d
PROMETHEUS_RETENTION_SIZE=5GB

# Prometheus alerting: Alertmanager UI on 127.0.0.1:9093. Set the SMTP
# values below to receive alert e-mails (empty values keep alerts in the UI).
ALERTMANAGER_SMTP_SMARTHOST=localhost:25
ALERTMANAGER_SMTP_FROM=alertmanager@${DOMAIN_NAME}
ALERTMANAGER_SMTP_USER=
ALERTMANAGER_SMTP_PASSWORD=
ALERTMANAGER_SMTP_REQUIRE_TLS=false
ALERTMANAGER_EMAIL_TO=admin@${DOMAIN_NAME}

# Backups (scripts/backup_daily.sh). Set a passphrase to encrypt archives at
# rest and include .env (encryption keys) in the backup. Without it, backups
# are written unencrypted and .env is omitted with a warning.
BACKUP_ENCRYPTION_PASSPHRASE=
# Alternatively use a GPG public key (takes precedence over the passphrase).
BACKUP_GPG_RECIPIENT=
# Optional rclone target, e.g. remote:cepem-backups.
BACKUP_REMOTE=
BACKUP_INCLUDE_ENV=true
BACKUP_VERIFY=true
# Restore the dump into a temporary database after each backup.
BACKUP_RESTORE_TEST=false
KEEP_BACKUPS=7
